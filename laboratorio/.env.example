# Configuración local del laboratorio.
# Copiar este archivo a laboratorio/.env (que NO se versiona) y ajustar si hace falta.
# preparar_sonarqube.py completa SONAR_ADMIN_CLAVE y SONAR_TOKEN automáticamente.

# Puerto de la máquina anfitriona donde se publica SonarQube.
SONAR_PUERTO=9000

# URL de SonarQube vista desde la máquina anfitriona (guiones de exportación).
SONAR_URL=http://localhost:9000

# Las completa preparar_sonarqube.py. No compartir: son credenciales de tu instancia local.
SONAR_ADMIN_CLAVE=
SONAR_TOKEN=
